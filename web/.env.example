# Server-side only. Copy to .env.local and fill in. Never commit real values.
TINKER_API_KEY=
# Sampler checkpoint path of the fine-tune, e.g. tinker://<run_id>:train:0/sampler_weights/<name>
MODEL_FINETUNE_PATH=
BASE_MODEL=Qwen/Qwen3-8B
# Optional override (defaults to the production OpenAI-compatible endpoint)
TINKER_OAI_BASE_URL=https://tinker.thinkingmachines.dev/services/tinker-prod/oai/api/v1
ELEVENLABS_API_KEY=
# Optional. Defaults to "George" (calm British male). Any library voice your plan allows works.
ELEVENLABS_VOICE_ID=
# Optional. Path to eval results JSON (defaults to ../eval/results.json)
EVAL_RESULTS_PATH=
